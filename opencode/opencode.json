{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "none"
      },
      "models": {
        "inkling-2-mini-q4": {
          "name": "Inkling 2 Mini Q4",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 16384, "output": 4096 }
        },
        "inkling-2-mini-q8": {
          "name": "Inkling 2 Mini Q8",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 16384, "output": 4096 }
        }
      }
    }
  },
  "model": "local-llm/inkling-2-mini-q4",
  "small_model": "local-llm/inkling-2-mini-q4"
}
