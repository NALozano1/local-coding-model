index 0000000..0d5603a
--- /dev/null
+++ b/tools/ik2_fp8_experts.py
@@ -0,0 +1,186 @@
+"""tools/ik2_fp8_experts.py - rewrites a GGUF's BF16 expert tensors, whose values are FP8 (E4M3) times a power of two a
+32 values, as maya-ik2's exact 34-byte blocks [FP16 2^k][32 x E4M3] (ik2::k::kFP8B) in tensors typed Q8_0 (the same
+geometry), and adds the KV maya.ik2.q8_exps_are_fp8 = 1.  Every value is checked to be unchanged; anything that is not
+exactly representable aborts.  The output is for maya-ik2 only: other readers would take those blocks for Q8_0.
+
+    PYTHONPATH=<llama.cpp>/gguf-py python tools/ik2_fp8_experts.py IN.gguf OUT.gguf
+    PYTHONPATH=<llama.cpp>/gguf-py python tools/ik2_fp8_experts.py IN.gguf --check      (nothing written)
+(the metadata copy follows gguf-py's scripts/gguf_new_metadata.py)
+"""
+import argparse
+import os
+import sys
+
+import numpy as np
+
+import gguf
+
+KV = 'maya.ik2.q8_exps_are_fp8'
+KMIN, KMAX = -24, 7          # 2^k exact in FP16, and 448 * 2^k not past FP16's largest
+CHUNK = 1 << 16              # blocks a step
+
+
+def _tables():
+    """by BF16 code: (usable, smallest k, largest k), and by (k, code) the E4M3 byte."""
+    code = np.arange(65536, dtype=np.int64)
+    sign, e, m = code >> 15, (code >> 7) & 255, code & 127
+    sig = np.where(e > 0, m | 128, m)
+    q = np.where(e > 0, e, 1) - 134                      # |value| = sig * 2^q
+    zero = (sig == 0) & (e != 255)
+    s = np.where(sig == 0, 1, sig)
+    tz = np.log2(s & -s).astype(np.int64)
+    odd = s >> tz
+    p = q + tz                                           # |value| = odd * 2^p
+    bits = np.floor(np.log2(odd)).astype(np.int64) + 1
+    top = p + bits - 1                                   # floor(log2 |value|)
+    # usable: finite, 4 significant bits at most, and exact in FP16
+    ok = zero | ((e != 255) & (odd < 16) & (p >= -24) & (top <= 15))
+    lo = np.where(zero, KMIN, top - 8 + (odd == 15))     # |value| <= 448 * 2^k
+    hi = np.where(zero, KMAX, p + 9)                     # the last bit no finer than 2^(k - 9)
+    lo, hi = np.maximum(lo, KMIN), np.minimum(hi, KMAX)
+    ok &= lo <= hi
+    enc = np.zeros((KMAX - KMIN + 1, 65536), np.uint8)
+    for k in range(KMIN, KMAX + 1):
+        fits = ok & (zero | ((lo <= k) & (k <= hi)))
+        x = top - k                                      # the exponent of value / 2^k
+        sub = odd << np.clip(p - k + 9, 0, 16)
+        nrm = (np.clip(x + 7, 0, 15) << 3) | ((odd << np.clip(4 - bits, 0, 3)) - 8)
+        mag = np.where(zero, 0, np.where(x < -6, sub, nrm))
+        enc[k - KMIN] = np.where(fits, (sign << 7) | mag, 0)
+    return ok, lo.astype(np.int8), hi.astype(np.int8), enc
+
+
+OK, LO, HI, ENC = _tables()
+# the decoders the check uses, from the formats' definitions (not from the tables above)
+_q = np.arange(256)
+E4M3 = (np.where(_q & 128, -1.0, 1.0) *
+        np.where((_q >> 3) & 15, (1 + (_q & 7) / 8) * 2.0 ** (((_q >> 3) & 15) - 7), (_q & 7) * 2.0 ** -9)
+        ).astype(np.float32)
+E4M3[[0x7F, 0xFF]] = np.nan
+BF16 = (np.arange(65536, dtype=np.uint32) << 16).view(np.float32)
+F16 = np.arange(65536, dtype=np.uint16).view(np.float16).astype(np.float32)
+
+
+def encode(codes):
+    """BF16 codes [n, 32] -> blocks [n, 34] uint8; raises unless every block has one k that keeps its values."""
+    if not OK[codes].all():
+        bad = codes[~OK[codes]]
+        raise ValueError(f'{bad.size} values are not E4M3 x 2^k exact in FP16, e.g. {BF16[bad[0]]!r}')
+    lo, hi = LO[codes].max(1).astype(np.int64), HI[codes].min(1).astype(np.int64)
+    if (lo > hi).any():
+        i = int(np.argmax(lo > hi))
+        raise ValueError(f'{int((lo > hi).sum())} blocks have no single scale, e.g. {BF16[codes[i]]}')
+    zero = ((codes & 0x7FFF) == 0).all(1)
+    k = np.where(zero, 0, lo)
+    out = np.empty((codes.shape[0], 34), np.uint8)
+    d = np.where(k >= -14, (k + 15) << 10, 1 << np.clip(k + 24, 0, 9)).astype('<u2')
+    out[:, :2] = d.view(np.uint8).reshape(-1, 2)
+    out[:, 2:] = ENC[(k - KMIN)[:, None], codes]
+    return out
+
+
+def verify(blocks, codes):
+    """blocks [n, 34] decode to exactly the BF16 values (bit for bit in F32)."""
+    d = blocks[:, :2].copy().view('<u2')[:, 0]
+    got = F16[d][:, None] * E4M3[blocks[:, 2:]]
+    if not np.array_equal(got.view(np.uint32), BF16[codes].view(np.uint32)):
+        raise ValueError('a converted block does not decode to its source values')
+
+
+def bf16_blocks(t):
+    """a BF16 tensor's bytes as codes [n, 32] (a view of the file)."""
+    if t.data.nbytes != 2 * t.n_elements or int(t.shape[0]) % 32:
+        raise ValueError(f'{t.name}: not rows of whole 32-value blocks')
+    return t.data.reshape(-1).view(np.uint8).view('<u2').reshape(-1, 32)
+
+
+def convert(t):
+    codes = bf16_blocks(t)
+    out = np.empty((codes.shape[0], 34), np.uint8)
+    for i in range(0, codes.shape[0], CHUNK):
+        c = np.asarray(codes[i:i + CHUNK])
+        out[i:i + CHUNK] = encode(c)
+        verify(out[i:i + CHUNK], c)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
+    ap.add_argument('input')
+    ap.add_argument('output', nargs='?')
+    ap.add_argument('--check', action='store_true', help='encode and verify only')
+    a = ap.parse_args()
+    if bool(a.output) == a.check:
+        ap.error('give OUT.gguf or --check')
+    r = gguf.GGUFReader(a.input)
+    if r.get_field(KV):
+        sys.exit(f'{a.input} has {KV} already')
+    exps = [t for t in r.tensors if t.name.endswith('_exps.weight')]
+    todo = {t.name for t in exps if t.tensor_type == gguf.GGMLQuantizationType.BF16}
+    if not todo:
+        sys.exit('no BF16 expert tensor')
+    q8 = [t.name for t in exps if t.tensor_type == gguf.GGMLQuantizationType.Q8_0]
+    if q8:   # (the KV would mark them as FP8 blocks too)
+        sys.exit(f'expert tensors that are Q8_0 already: {q8}')
+    if a.check:
+        for t in r.tensors:
+            if t.name in todo:
+                n = convert(t).shape[0]
+                print(f'ok {t.name}: {n} blocks exact', flush=True)
+        print(f'CHECK OK: {len(todo)} tensors')
+        return
+    if os.path.exists(a.output):
+        sys.exit(f'{a.output} exists')
+
+    arch = r.get_field(gguf.Keys.General.ARCHITECTURE).contents()
+    part = a.output + '.part'
+    w = gguf.GGUFWriter(part, arch=arch, endianess=r.endianess)
+    al = r.get_field(gguf.Keys.General.ALIGNMENT)
+    if al is not None:
+        w.data_alignment = al.contents()
+    for f in r.fields.values():
+        if f.name == gguf.Keys.General.ARCHITECTURE or f.name.startswith('GGUF.'):
+            continue
+        vt = f.types[0]
+        w.add_key_value(f.name, f.contents(), vt, sub_type=f.types[-1] if vt == gguf.GGUFValueType.ARRAY else None)
+    w.add_key_value(KV, 1, gguf.GGUFValueType.UINT32)
+    for t in r.tensors:
+        if t.name in todo:
+            ne = [int(x) for x in t.shape]               # (ggml's order: a row's length first)
+            bshape = (*ne[:0:-1], ne[0] // 32 * 34)
+            w.add_tensor_info(t.name, bshape, np.dtype(np.uint8), int(np.prod(bshape)), gguf.GGMLQuantizationType.Q8_0)
+        else:
+            w.add_tensor_info(t.name, t.data.shape, t.data.dtype, t.data.nbytes, t.tensor_type)
+    w.write_header_to_file()
+    w.write_kv_data_to_file()
+    w.write_ti_data_to_file()
+    for t in r.tensors:
+        if t.name in todo:
+            w.write_tensor_data(convert(t), tensor_endianess=r.endianess)
+            print(f'converted {t.name}', flush=True)
+        else:
+            w.write_tensor_data(t.data, tensor_endianess=r.endianess)
+    w.close()
+
+    # the file as written: every other tensor's bytes unchanged, every converted value the source's
+    o = gguf.GGUFReader(part)
+    if [t.name for t in o.tensors] != [t.name for t in r.tensors] or o.get_field(KV).contents() != 1:
+        sys.exit('written file: tensor list or KV differs')
+    for s, t in zip(r.tensors, o.tensors):
+        if [int(x) for x in s.shape] != [int(x) for x in t.shape]:
+            sys.exit(f'written file: {s.name} shape {t.shape}')
+        if s.name in todo:
+            if t.tensor_type != gguf.GGMLQuantizationType.Q8_0:
+                sys.exit(f'written file: {s.name} type')
+            src, dst = bf16_blocks(s), t.data.reshape(-1).view(np.uint8).reshape(-1, 34)
+            for i in range(0, src.shape[0], CHUNK):
+                verify(np.asarray(dst[i:i + CHUNK]), np.asarray(src[i:i + CHUNK]))
+        elif s.tensor_type != t.tensor_type or not np.array_equal(s.data.reshape(-1).view(np.uint8),
+                                                                  t.data.reshape(-1).view(np.uint8)):
+            sys.exit(f'written file: {s.name} differs')
+    os.rename(part, a.output)
+    print(f'WRITTEN AND VERIFIED {a.output}: {len(todo)} tensors converted, {len(r.tensors) - len(todo)} unchanged')
+
+
+if __name__ == '__main__':
+    main()
