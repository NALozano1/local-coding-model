+// random bytes made BF16 values in [1/16, 4) in magnitude (all exact in FP16)
+void fix_bf16(std::vector<uint8_t>& raw) {
+    for (size_t i = 0; i + 1 < raw.size(); i += 2) {
+        uint16_t h = (uint16_t) (raw[i] | (raw[i + 1] << 8));
+        h = (uint16_t) ((h & 0x807F) | ((123 + ((h >> 7) & 0xFF) % 6) << 7));
+        raw[i] = (uint8_t) h, raw[i + 1] = (uint8_t) (h >> 8);
+    }
+}
+// random bytes made kFP8B blocks as tools/ik2_fp8_experts.py writes them: an FP16 scale 2^k and no E4M3 NaN
+void fix_fp8b(std::vector<uint8_t>& raw) {
+    for (size_t b = 0; b + 34 <= raw.size(); b += 34) {
+        const uint16_t d = (uint16_t) ((15 - raw[b] % 8) << 10);
+        raw[b] = (uint8_t) d, raw[b + 1] = (uint8_t) (d >> 8);
+        for (int i = 0; i < 32; ++i)
+            if ((raw[b + 2 + i] & 0x7F) == 0x7F) raw[b + 2 + i] ^= 1;
+    }
+}
+
+// decode_host of BF16 and kFP8B against the formats' definitions, every code (no device)
+void test_new_types_host() {
+    {
+        std::vector<uint8_t> raw(65536 * 2);
+        for (int i = 0; i < 65536; ++i) raw[2 * i] = (uint8_t) i, raw[2 * i + 1] = (uint8_t) (i >> 8);
+        std::vector<float> got(65536);
+        k::decode_host(k::kBF16, raw.data(), got.size(), got.data());
+        bool ok = k::block_values(k::kBF16) == 32 && k::block_bytes(k::kBF16) == 64;
+        for (int i = 0; i < 65536; ++i) {
+            const int s = i >> 15, e = (i >> 7) & 255, m = i & 127;
+            if (e == 255) {
+                ok &= m ? std::isnan(got[i]) : std::isinf(got[i]) && (got[i] < 0) == (s != 0);
+                continue;
+            }
+            const double v = (s ? -1.0 : 1.0) * (e ? std::ldexp(1.0 + m / 128.0, e - 127) : std::ldexp(m / 128.0, -126));
+            ok &= (double) got[i] == v;
+        }
+        expect_true("decode_host BF16: the format's definition", ok);
+    }
+    {
+        bool ok = k::block_values(k::kFP8B) == 32 && k::block_bytes(k::kFP8B) == 34;
+        for (int kk = -24; kk <= 7; ++kk) {
+            const uint16_t d = (uint16_t) (kk >= -14 ? (kk + 15) << 10 : 1 << (kk + 24));
+            std::vector<uint8_t> raw(8 * 34);
+            for (int q = 0; q < 256; ++q) {
+                uint8_t* b = raw.data() + (q / 32) * 34;
+                b[0] = (uint8_t) d, b[1] = (uint8_t) (d >> 8), b[2 + q % 32] = (uint8_t) q;
+            }
+            std::vector<float> got(256);
+            k::decode_host(k::kFP8B, raw.data(), got.size(), got.data());
+            for (int q = 0; q < 256; ++q) {
+                if ((q & 0x7F) == 0x7F) {
+                    ok &= std::isnan(got[q]);
+                    continue;
+                }
+                const int e = (q >> 3) & 15, m = q & 7;
+                const double v = (q & 128 ? -1.0 : 1.0) * (e ? std::ldexp(1.0 + m / 8.0, e - 7) : std::ldexp(m / 8.0, -6));
+                ok &= (double) got[q] == std::ldexp(v, kk);
+            }
+        }
+        expect_true("decode_host FP8B: the format's definition", ok);
+    }
